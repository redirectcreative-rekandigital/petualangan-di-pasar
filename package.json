{
  "name": "survival-sains",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Survival Sains - game petualangan IPA kelas 5 SD/MI: terdampar di Pulau Wonorejo, pelajari 9 bab IPA bersama 9 penjaga, lalu nyalakan Mercusuar Tua.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "dev:server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:bank": "tsx scripts/verify-bank.ts",
    "cek:terjemahan": "tsx scripts/terjemahan.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:guru": "node scripts/smoke-guru.mjs",
    "build:avatar": "node scripts/build-avatar.mjs",
    "kompres:model": "node scripts/kompres-model.mjs",
    "serve": "node server/index.mjs",
    "serve:dev": "npm run build && node server/index.mjs",
    "naskah": "tsx scripts/gen-naskah.ts"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "three": "^0.182.0",
    "ws": "^8.22.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
